# 텔레그램 봇 토큰 (npm run bot 실행 시 필요, CLI 검증엔 불필요)
TELEGRAM_BOT_TOKEN=

# 슬랙 봇 토큰 (npm run slack 실행 시 필요, Socket Mode)
#  SLACK_BOT_TOKEN : Bot User OAuth Token (xoxb-...) — 스코프: app_mentions:read, chat:write,
#                    channels:history, im:history, files:read
#  SLACK_APP_TOKEN : App-Level Token (xapp-...) — Socket Mode 활성화 + connections:write 스코프
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
